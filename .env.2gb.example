# ===========================================
# 2GB 服务器方案专用环境变量（可直接复制为 .env）
# 架构：本机跑 Go API + PostgreSQL + Redis + Nginx(后台静态)
#       前台 Next.js → Vercel
#       图片 → Cloudflare R2
# 详见 docs/deployment-2gb.md
# ===========================================

# ---------- 运行环境 ----------
APP_ENV=production
API_PORT=8888
API_DOMAIN=api.yourbrand.com
CORS_ORIGINS=https://yourbrand.com,https://www.yourbrand.com,https://admin.yourbrand.com

# ---------- 数据库（本机容器 PostgreSQL）----------
DATABASE_URL=postgres://shop:请修改为强密码@postgres:5432/shop?sslmode=disable
PG_USER=shop
PG_PASSWORD=请修改为强密码
PG_DB=shop

# ---------- Redis（本机容器）----------
REDIS_ADDR=redis:6379
REDIS_PASSWORD=请修改为强密码
REDIS_DB=0

# ---------- JWT ----------
# 生成：openssl rand -base64 48
JWT_SECRET=请替换为随机48字节字符串
JWT_EXPIRE_HOURS=72
ADMIN_JWT_SECRET=请替换为另一个随机字符串
ADMIN_JWT_EXPIRE_HOURS=12

# ---------- Cloudflare R2（图片存储，出站免费）----------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=shop-assets
R2_PUBLIC_URL=https://img.yourbrand.com
R2_PRESIGN_EXPIRE=600
# 图片上传限制
UPLOAD_MAX_SIZE=5242880
UPLOAD_ALLOW_TYPES=image/jpeg,image/png,image/webp,image/avif

# ---------- Stripe ----------
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_CURRENCY=USD
# 支付回调 HMAC 签名密钥（生产必填，生成：openssl rand -base64 32）
PAYMENT_WEBHOOK_SECRET=

# ---------- 邮件（Resend）----------
RESEND_API_KEY=
MAIL_FROM=shop@yourbrand.com

# ---------- 可观测 ----------
SENTRY_DSN=
LOG_LEVEL=info

# ---------- 前台（这些是 Vercel 侧环境变量，非服务器用）----------
NEXT_PUBLIC_API_BASE_URL=https://api.yourbrand.com
NEXT_PUBLIC_SITE_URL=https://yourbrand.com
NEXT_PUBLIC_IMG_BASE_URL=https://img.yourbrand.com

# ===========================================
# 内存档位 B：2GB 机型（t3.small）
# ===========================================
PG_MEM_LIMIT=640M
PG_SHARED_BUFFERS=128MB
PG_EFFECTIVE_CACHE=512MB
PG_WORK_MEM=4MB
PG_MAX_CONN=40
PG_MAINT_WORK_MEM=64MB
PG_MAX_WAL=768MB
REDIS_MEM_LIMIT=192M
REDIS_MAXMEMORY=128mb
API_MEM_LIMIT=256M
GOGC=80
GOMEMLIMIT=220MiB
NGINX_MEM_LIMIT=96M

# ---------- 备份（R2 异地）----------
R2_BACKUP_BUCKET=shop-backups
RETENTION_DAYS=14
