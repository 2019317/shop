# ===========================================
# 环境变量模板
# 当前方案：2GB 服务器（后端） + Vercel（前台） + Cloudflare R2（图片）
# 详见 docs/deployment-2gb.md
# 复制为 .env 后填写，切勿提交到仓库
# ===========================================

# ---------- 运行环境 ----------
APP_ENV=production                # local | staging | production
API_PORT=8888
API_DOMAIN=api.yourbrand.com      # Nginx 反代的后端域名
CORS_ORIGINS=https://yourbrand.com,https://www.yourbrand.com,https://shop-admin.pages.dev

# ---------- 数据库（本机容器 PostgreSQL；换 Neon 时改这里即可）----------
# 本机容器：postgres://shop:你的密码@postgres:5432/shop?sslmode=disable
# Neon 示例：postgres://user:pass@ep-xxx.region.aws.neon.tech/shop?sslmode=require
DATABASE_URL=postgres://shop:请设置密码@postgres:5432/shop?sslmode=disable
DATABASE_MAX_CONN=40
DATABASE_MAX_IDLE=5

# ---------- Redis（VPS 内 Docker 自建 / 或 Upstash）----------
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0

# ---------- JWT ----------
# 生成：openssl rand -base64 48
JWT_SECRET=please_change_me_to_a_random_48_bytes_string
JWT_EXPIRE_HOURS=72
ADMIN_JWT_SECRET=please_change_me_admin_another_random_string
ADMIN_JWT_EXPIRE_HOURS=12

# ---------- Cloudflare R2（图片/制品图存储）----------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=shop-assets
# 绑定在 R2 上的自定义域名（Cloudflare 托管），例如 https://img.yourbrand.com
R2_PUBLIC_URL=https://img.yourbrand.com
# 直传签名 URL 有效期（秒）
R2_PRESIGN_EXPIRE=600

# ---------- Stripe ----------
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_CURRENCY=USD

# ---------- 邮件（Resend）----------
RESEND_API_KEY=
MAIL_FROM=shop@yourbrand.com

# ---------- 可观测 ----------
SENTRY_DSN=
LOG_LEVEL=info

# ===========================================
# 单机部署 — 机型内存档位（四选一）
# 当前方案为 2GB，请启用「档位 B」
# 若使用 Neon 托管数据库，请忽略 PG_* 相关配置
# ===========================================
#
# ---------- 档位 A：1GB 机型（t3.micro）----------
# PG_MEM_LIMIT=320M
# PG_SHARED_BUFFERS=64MB
# PG_EFFECTIVE_CACHE=256MB
# PG_WORK_MEM=2MB
# PG_MAX_CONN=20
# REDIS_MEM_LIMIT=96M
# REDIS_MAXMEMORY=64mb
# API_MEM_LIMIT=192M
# GOGC=60
# GOMEMLIMIT=160MiB
# NGINX_MEM_LIMIT=64M
#
# ---------- 档位 B：2GB 机型（t3.small）★ 当前方案启用此档 ----------
# 启用方法：去掉下面各行的 # 号
# PG_MEM_LIMIT=640M
# PG_SHARED_BUFFERS=128MB
# PG_EFFECTIVE_CACHE=512MB
# PG_WORK_MEM=4MB
# PG_MAX_CONN=40
# PG_MAINT_WORK_MEM=64MB
# PG_MAX_WAL=768MB
# REDIS_MEM_LIMIT=192M
# REDIS_MAXMEMORY=128mb
# API_MEM_LIMIT=256M
# GOGC=80
# GOMEMLIMIT=220MiB
# NGINX_MEM_LIMIT=96M
#
# ---------- 档位 C：4GB 机型（t3.medium / t4g.medium）推荐 ----------
# PG_MEM_LIMIT=1024M
# PG_SHARED_BUFFERS=256MB
# PG_EFFECTIVE_CACHE=1GB
# PG_WORK_MEM=8MB
# PG_MAX_CONN=60
# PG_MAINT_WORK_MEM=128MB
# PG_MAX_WAL=1GB
# REDIS_MEM_LIMIT=320M
# REDIS_MAXMEMORY=256mb
# API_MEM_LIMIT=384M
# GOGC=100
# GOMEMLIMIT=320MiB
# NGINX_MEM_LIMIT=128M
#
# ---------- 档位 D：4GB 机型 + 前台 SSR 全栈（本机跑 Next.js）----------
# 适用：坚持把前台也放服务器，且需要 SSR（next start 常驻 Node）
# 启动：docker compose -f infra/docker-compose.all-in-one.yml --profile frontend up -d
# 注意：此档位 Node 常驻约 500MB，2GB 机型请勿使用
# PG_MEM_LIMIT=1024M
# PG_SHARED_BUFFERS=256MB
# PG_EFFECTIVE_CACHE=1GB
# PG_WORK_MEM=8MB
# PG_MAX_CONN=60
# PG_MAINT_WORK_MEM=128MB
# PG_MAX_WAL=1GB
# REDIS_MEM_LIMIT=320M
# REDIS_MAXMEMORY=256mb
# API_MEM_LIMIT=384M
# GOGC=100
# GOMEMLIMIT=320MiB
# NGINX_MEM_LIMIT=128M
# NODE_OPTIONS=--max-old-space-size=384
#
# 若改用「静态导出」前台（output: 'export'，Nginx 托管、无 Node 常驻），
# 则不需要 --profile frontend，直接在 2GB 机型使用「档位 B」即可。

# ---------- 单机数据库（使用 Neon 时无需配置）----------
PG_USER=shop
PG_PASSWORD=
PG_DB=shop

# ---------- 前台（Vercel 环境变量）----------
NEXT_PUBLIC_API_BASE_URL=https://api.yourbrand.com
NEXT_PUBLIC_SITE_URL=https://yourbrand.com
NEXT_PUBLIC_IMG_BASE_URL=https://img.yourbrand.com
